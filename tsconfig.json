{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2021",
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*"
    ]
}
