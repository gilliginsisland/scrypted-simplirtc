      "@scrypted/sdk": "^0.3.61",
      "sdp-transform": "^3.0.0",
      "werift": "0.17.6",
      "ws": "^8.17.1",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@types/node": "^20.14.10",
      "@types/sdp-transform": "^3.0.0",
      "@types/ws": "^8.5.10",
      "typescript": "^5.5.4"
   }
}
