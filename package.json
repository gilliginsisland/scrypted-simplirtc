{
   "name": "@gilliginsisland/scrypted-simplirtc",
   "version": "0.0.6",
   "description": "Native SimpliSafe camera plugin for Scrypted.",
   "type": "commonjs",
   "files": [
      "dist/plugin.zip",
      "README.md",
      "LICENSE"
   ],
   "repository": {
      "type": "git",
      "url": "git+https://github.com/gilliginsisland/scrypted-simplirtc.git"
   },
   "bugs": {
      "url": "https://github.com/gilliginsisland/scrypted-simplirtc/issues"
   },
   "homepage": "https://github.com/gilliginsisland/scrypted-simplirtc#readme",
   "keywords": [
      "scrypted",
      "plugin",
      "simplisafe",
      "camera",
      "webrtc"
   ],
   "license": "MIT",
   "scrypted": {
      "name": "SimpliSafe Cameras",
      "type": "DeviceProvider",
      "interfaces": [
         "DeviceProvider",
         "Settings",
         "Refresh"
      ],
      "pluginDependencies": [
         "@scrypted/webrtc"
      ]
   },
   "dependencies": {
      "@livekit/protocol": "^1.50.4",
      "@scrypted/sdk": "^0.5.59",
      "sdp-transform": "^3.0.0",
      "werift": "0.24.1",
      "ws": "^8.21.1",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@types/node": "^26.1.2",
      "@types/sdp-transform": "^3.0.0",
      "@types/ws": "^8.18.1"
   },
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "preprepublishOnly": "scrypted-changelog",
      "prepublishOnly": "scrypted-changelog && NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-changelog": "scrypted-changelog",
      "scrypted-package-json": "scrypted-package-json"
   }
}
